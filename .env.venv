# =============================================================================
# SynapHR AI - Venv (Local Development) Environment Configuration
# =============================================================================
# This file is used when running without Docker.
# Copy this to .env and adjust as needed.
# =============================================================================

# Django
DJANGO_SECRET_KEY=django-insecure-venv-dev-key-do-not-use-in-production-abc123xyz
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database - SQLite is used automatically in venv mode
# No PostgreSQL configuration needed

# Redis - Not required in venv mode (uses in-memory fallbacks)
# No Redis configuration needed

# DeepSeek AI (optional - leave empty to disable AI features)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=text-embedding-ada-002

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email (optional - uses console backend in venv mode)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@aihrms.com
